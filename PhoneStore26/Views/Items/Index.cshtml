@model Phone[]

<div class="row row-cols-1 row-cols-md-3 g-4">
    @for (int i = 0; i < Model.Length; ++i)
    {
        string Manufacturer = "";//@Model[i].Manufacturer;
        string Series = @Model[i].Series;
        double Price = @Model[i].Price;
        string Description = @Model[i].Description;

        <div class="col">
            <div class="card h-100">
                <img src="https://files.foxtrot.com.ua/PhotoNew/img_0_60_12258_0_1_UlIhI1.webp" class="card-img-top" alt="...">
                <div class="card-body">
                    <p class="card-text">
                        We sell <b>@Model[i].Manufacturer</b> <b>@Model[i].Series</b> for $<b>@Model[i].Price</b> becouse this's <b>@Model[i].Description</b>
                    </p>

                    <form asp-action="Buy">
                        <input type="hidden" class="form-control" asp-for="@Manufacturer">
                        <input type="hidden" class="form-control" asp-for="@Series">
                        <input type="hidden" class="form-control" asp-for="@Description">
                        <div class="mb-3">
                            <label class="form-label">Пропозиція нової ціни від потенційного покупця</label>
                            <input type="text" class="form-control" asp-for="@Price">
                        </div>
                        <button type="submit" class="btn btn-primary">Купити</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>