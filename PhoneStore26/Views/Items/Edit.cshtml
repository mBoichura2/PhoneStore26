@model PhoneStore26.Models.Phone

<h1>Редагувати телефон</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <label>ManufacturerId:</label><br>
    <input asp-for="ManufacturerId" /><br><br>

    <label>CategoryId:</label><br>
    <input asp-for="CategoryId" /><br><br>

    <label>Series:</label><br>
    <input asp-for="Series" /><br><br>

    <label>Price:</label><br>
    <input asp-for="Price" /><br><br>

    <label>Description:</label><br>
    <input asp-for="Description" /><br><br>

    <button type="submit">Оновити дані</button>
</form>

<br>
<a asp-action="Index">Назад до списку</a>