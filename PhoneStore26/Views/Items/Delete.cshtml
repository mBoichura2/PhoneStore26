@using DataAccess.Entities
@model Phone

<h1>Видалити телефон?</h1>

<p><b>Id:</b> @Model.Id</p>
<p><b>Series:</b> @Model.Series</p>
<p><b>Price:</b> @Model.Price</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Так, видалити назавжди</button>
</form>

<br>
<a asp-action="Index">Скасувати</a>